# Copy to .env for local development. On the server these are set as
# environment variables of the Docker project, never committed.

DATABASE_URL=postgresql://hausjo:CHANGE_ME@db:5432/hausjo
# Long random string (at least 32 characters) used to sign login sessions
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Public address of the app
APP_URL=https://beta.hausjo.co.id
# Where uploaded KTP, selfie, store photos and QRIS stickers are stored (Docker volume)
UPLOAD_DIR=/data/uploads

# Email (Gmail: needs 2-Step Verification and an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hausjoapp@gmail.com
SMTP_PASS=
MAIL_FROM="HausJo <hausjoapp@gmail.com>"

# KTP OCR: OCR_PROVIDER=google + a Google Cloud API key restricted to the Cloud Vision API. Empty = typed by hand.
OCR_PROVIDER=
OCR_API_KEY=

# First admin account, created on start-up if no admin exists yet
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
