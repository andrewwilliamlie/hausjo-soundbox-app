// HausJo merchant onboarding data model.
// Column comments name the matching column in the QRIS Sheet used for bank exports.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppStatus {
  DRAFT       // signup started, not submitted
  SUBMITTED   // waiting for admin review ("Baru")
  REVISION    // one or more documents rejected ("Perlu revisi")
  BANK        // approved, sent to bank ("Proses bank")
  ACTIVE      // NMID + sticker saved ("QRIS aktif")
  REJECTED    // closed ("Ditolak")
}

enum Product {
  SOUNDBOX
  QRIS
}

enum SoundboxStatus {
  NONE        // QRIS only
  BUY         // buys in the app (Doku)
  MARKETPLACE // already ordered on a marketplace (orderNo)
  SALES       // through a HausJo sales rep (salesName)
  ARRIVED     // already delivered, SN scanned in the app
}

enum Settlement {
  H1
  SAME_DAY
}

enum PartnerBank {
  BCA
  NOBU
  BAYARIND
}

enum DocKind {
  KTP
  SELFIE
  STORE_FRONT
  PRODUCT
  QRIS_STICKER
}

enum DocDecision {
  PENDING
  APPROVED
  REJECTED
}

enum AdminRole {
  REVIEWER    // checks documents
  ACTIVATION  // routes to bank, enters bank IDs, uploads stickers
  ADMIN       // everything, incl. exports and users
}

model User {
  id           String        @id @default(cuid())
  phone        String        @unique // NO WHATSAPP PEMILIK USAHA
  email        String        @unique // ALAMAT EMAIL
  passwordHash String
  referralCode String?
  createdAt    DateTime      @default(now())
  passwordChangedAt DateTime? // sessions issued before this are rejected
  failedLogins Int       @default(0) // wrong PIN attempts in a row
  lockedUntil  DateTime? // login blocked until this time after too many wrong PINs
  applications Application[]
  passwordResets PasswordReset[]
  invoices       Invoice[]
  products       InvoiceProduct[]
  invoiceCode    String?   // short code in invoice numbers, e.g. INV-WMR-261105-001
  stickerOrders  StickerOrder[]
  helpRequests   HelpRequest[]
  shipAddresses  ShipAddress[]
}

// One-time link to set a new merchant password (only the SHA-256 of the token is stored)
model PasswordReset {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  byAdminId   String?   // set when an admin sent the link
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model Application {
  id        String    @id @default(cuid())
  ticket    String    @unique // HJO-YYYYMMDD-XXXXX
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  status    AppStatus @default(DRAFT)

  product        Product        @default(SOUNDBOX)
  soundboxStatus SoundboxStatus @default(BUY)
  marketplace    String?
  orderNo        String?
  salesName      String?
  soundboxPaidAt DateTime?

  // Owner, from the e-KTP (OCR-filled, confirmed by the merchant)
  ktpName       String? // NAMA LENGKAP PEMILIK USAHA
  nik           String? // NIK E-KTP PEMILIK USAHA
  birthPlace    String?
  birthDate     String?
  gender        String?
  religion      String?
  occupation    String?
  ktpAddress    String?
  ocrConfidence Int?
  ocrEdited     Boolean @default(false)
  livenessPassed Boolean?  // selfie taken through the on-phone liveness check (true) or uploaded without it (false)
  livenessAt     DateTime?
  livenessNote   String?   // e.g. "kedip, senyum · 9 dtk" or why it was skipped

  // Business
  hasStore     Boolean @default(true)  // APAKAH MEMILIKI TOKO FISIK?
  sellsOffline Boolean @default(true)
  sellsOnline  Boolean @default(false)
  onlineLink   String? // WEBSITE
  businessType String?
  businessName String? // NAMA USAHA (max 25, capitals)
  street       String? // nama jalan
  number       String? // nomor / blok tempat usaha
  rt           String?
  rw           String?
  kelurahan    String?
  kecamatan    String?
  city         String? // KOTA / KABUPATEN
  province     String?
  postalCode   String? // KODE POS
  villageCode  String? // Kemendagri kelurahan/desa code, e.g. 32.73.01.1001
  lat          Float?
  lng          Float?
  turnover     String  @default("UMI") // KATEGORI USAHA BERDASARKAN OMZET

  // Payout (added in the app; required before the bank can issue the NMID)
  bankName      String? // BANK PENAMPUNG
  accountNo     String? // NO REK PENAMPUNG
  accountHolder String? // Nama Pemilik Rekening
  settlement    Settlement @default(H1) // drives MDR HAUSJO (%)

  // Admin-only
  routedBank   PartnerBank?
  mcc          String? // MCC - JENIS USAHA
  riskCategory String? // KATEGORI USAHA BERDASARKAN RISK
  qrisType     String? // TIPE QRIS
  mpan         String? // MPAN
  mid          String? // MID
  nmid         String? // NMID NOBU / NMID BAYARIND / NMID BCA (by routedBank)
  serialNumber String? // Serial Number
  picActivation String? // PIC Aktivasi (filled by hand)
  activatedAt  DateTime?
  courier      String?
  trackingNo   String?
  shippedAt    DateTime?
  needsGuide   Boolean   @default(false)
  guidedAt     DateTime?
  revisionNote String?

  submittedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]
  audits      AuditLog[]

  @@index([status])
}

model Document {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          DocKind
  storagePath   String      // under UPLOAD_DIR, never served directly
  mime          String
  size          Int
  decision      DocDecision @default(PENDING)
  rejectReason  String?
  createdAt     DateTime    @default(now())

  @@index([applicationId, kind])
}

model Admin {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         AdminRole  @default(REVIEWER)
  active       Boolean    @default(true)
  mustChangePassword Boolean @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  audits       AuditLog[]
}

model AuditLog {
  id            String       @id @default(cuid())
  adminId       String?
  admin         Admin?       @relation(fields: [adminId], references: [id])
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  action        String       // e.g. VIEW_KTP, APPROVE, EXPORT
  detail        String?
  createdAt     DateTime     @default(now())
}


enum InvoiceStatus {
  UNPAID
  PAID
  SHIPPED
  DONE
  CANCELLED
}

// AIPOS Invoice: invoices a merchant sends to customers, with their QRIS attached when shared.
model Invoice {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?       // the store (outlet) the invoice is from; its QRIS is attached
  number        String        // INV-CODE-YYMMDD-001
  customerName  String
  customerPhone String?
  orderDate     String        // YYYY-MM-DD
  note          String?
  items         Json          // [{ productId?, name, price, qty, note? }]
  deliveryType  String        // "ambil" | "kirim"
  deliveryAddress String?
  deliveryFee   Int           @default(0)
  discountType  String        @default("rp") // "rp" | "pct"
  discountValue Int           @default(0)
  taxPct        Float         @default(0)
  subtotal      Int
  discount      Int
  tax           Int
  total         Int
  status        InvoiceStatus @default(UNPAID)
  payMethod     String?
  paidAt        DateTime?
  history       Json          // [{ s: status, at: ISO time, m?: pay method }]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, number])
  @@index([userId, createdAt])
}

model InvoiceProduct {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  price     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, name])
}


enum StickerStatus {
  UNPAID     // order placed, waiting for payment
  PAID       // payment received
  PRINTING   // being printed / assembled
  SHIPPED    // handed to the courier (trackingNo)
  DONE       // received
  CANCELLED
}

// Shop orders from the app: printed QRIS stickers / acrylic stands ("Pesan stiker") and EDC terminals ("Beli EDC").
// One order is for one store.
model StickerOrder {
  id            String        @id @default(cuid())
  kind          String        @default("STIKER") // STIKER | EDC
  number        String        @unique // STK-YYMMDD-XXXX or EDC-YYMMDD-XXXX
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String        // the store whose QRIS is printed
  items         Json          // [{ code, name, qty, price, normalPrice }]
  // Delivery address, copied at order time so later address edits don't change the order
  label         String
  recipient     String
  phone         String
  address       String
  kelurahan     String
  kecamatan     String
  city          String
  province      String
  postalCode    String
  courierNote   String?
  timeSlot      String?       // e.g. "12.00-17.00"
  subtotal      Int
  normalTotal   Int           // before the promo price, for "Penghematan"
  shippingFee   Int
  total         Int
  status        StickerStatus @default(UNPAID)
  payMethod     String?
  paidAt        DateTime?
  courier       String?
  trackingNo    String?
  shippedAt     DateTime?
  adminNote     String?
  history       Json          // [{ s: status, at: ISO time, by?: admin name }]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Saved delivery addresses for sticker orders ("Pilih alamat").
model ShipAddress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   // Rumah, Toko, Kantor, ...
  recipient   String
  phone       String
  address     String   // street, building, number
  kelurahan   String
  kecamatan   String
  city        String
  province    String
  postalCode  String
  villageCode String?
  courierNote String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// "Minta CS menelepon saya" from the Bantuan help center, after the merchant tried the guide.
model HelpRequest {
  id            String    @id @default(cuid())
  number        String    @unique // BNT-YYMMDD-XXXX
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?   // the store being viewed when asking
  topic         String    // help topic id, e.g. "edc-offline"
  phone         String    // number CS should call
  callTime      String    // Secepatnya / Pagi / Siang / Sore
  note          String?
  triedSteps    Int       @default(0) // how many guide steps the merchant ticked
  status        String    @default("OPEN") // OPEN | CALLED | DONE
  adminNote     String?
  handledBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
